# Copy to /etc/ddos-cti-stage/stage.env and replace placeholders securely.
# Never commit the completed file.
# Runtime rotation helper:
#   sudo bash scripts/update_integration_settings.sh --show
#   sudo bash scripts/update_integration_settings.sh --abuseipdb-key
#   sudo bash scripts/update_integration_settings.sh --threatfox-url
# GitHub URL, username, and token do not belong in this file. They are
# installation/update inputs and are not used by the daily collector.

ABUSEIPDB_API_KEY=REPLACE_WITH_ABUSEIPDB_API_KEY
ABUSEIPDB_LIMIT=1000
ABUSEIPDB_SCORE=100
ABUSEIPDB_IPVERSION=4

# Optional override. Leave commented to use the collector's approved default.
# ABUSEIPDB_API_URL=https://api.abuseipdb.com/api/v2/blacklist

# Supply the approved public or protected ThreatFox CSV/ZIP export URL.
# Treat the complete URL as a secret because protected URLs may embed authorization.
THREATFOX_CSV_URL=https://threatfox-api.abuse.ch/v2/files/exports/REPLACE_WITH_AUTH_KEY/full.csv.zip
THREATFOX_IOC_TO_IMPORT=ip:port
THREATFOX_IMPORT_OFFLINE=true
THREATFOX_INTERVAL=1

STAGE_MAX_DOWNLOAD_BYTES=536870912
STAGE_CONNECT_TIMEOUT=15
STAGE_READ_TIMEOUT=180
STAGE_OUTPUT_GROUP=ddos-cti-readers
